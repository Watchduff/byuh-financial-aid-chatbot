{
  "name": "nextjs-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "predev": "powershell -Command \"Remove-Item -Path './.next/dev/lock' -Force -ErrorAction SilentlyContinue; $p = (Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue).OwningProcess; if ($p) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue }; exit 0\"",
    "dev": "concurrently --kill-others-on-fail --names \"next,fastapi\" --prefix-colors \"blue,green\" \"next dev --port 3000\" \".venv\\\\Scripts\\\\python -m uvicorn backend.app.main:app --reload --port 8000\"",
    "build": "next build",
    "start": "next start",
    "fastapi:dev": ".venv\\Scripts\\python -m uvicorn backend.app.main:app --reload --port 8000",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "ingest": "tsx --env-file=.env.local src/scripts/ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.144",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.6",
    "openai": "^4.104.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
